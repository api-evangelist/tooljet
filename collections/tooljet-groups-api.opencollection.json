                "description": "Filter groups by name"
              },
              {
                "name": "page",
                "value": "",
                "type": "query",
                "description": "Page number"
              },
              {
                "name": "per_page",
                "value": "",
                "type": "query",
                "description": "Results per page"
              }
            ]
          },
          "docs": "List groups in workspace"
