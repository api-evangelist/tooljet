{
  "opencollection": "1.0.0",
  "info": {
    "name": "ToolJet External Applications Workspaces API",
    "version": "1.0.0"
  },
  "request": {
    "auth": {
      "type": "basic",
      "username": "{{username}}",
      "password": "{{password}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Workspaces",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List all workspaces",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://{instance}/api/ext/workspaces"
          },
          "docs": "List all workspaces"
        },
        {
          "info": {
            "name": "Update user role in a workspace",
            "type": "http"
          },
          "http": {
            "method": "PUT",
            "url": "https://{instance}/api/ext/update-user-role/workspace/:workspaceId",
            "params": [
              {
                "name": "workspaceId",
                "value": "",
                "type": "path",
                "description": "Workspace UUID"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Update user role in a workspace"
        }
      ]
    }
  ],
  "bundled": true
}